model User {
  id        String     @id @default(cuid())
  name      String?
  email     String?    @unique
  password  String
  image     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  posts     Post[]
  streak    Streak[]
  progress  Progress[]
  goals     Goal[]

  // Author Relations
  roadmaps  Roadmap[]  @relation(name: "userRoadmap")
  topics    Topic[]    @relation(name: "userTopic")
  subTopics SubTopic[] @relation(name: "userSubtopic")

  // Updater Relations
  updatedRoadmaps  Roadmap[]  @relation(name: "updaterRoadmap")
  updatedTopics    Topic[]    @relation(name: "updaterTopic")
  updatedSubTopics SubTopic[] @relation(name: "updaterSubtopic")

  @@map(name: "users")
}

model Post {
  id        String  @id @default(cuid())
  title     String
  content   String?
  published Boolean @default(false)
  author    User?   @relation(fields: [authorId], references: [id])
  authorId  String?
}
